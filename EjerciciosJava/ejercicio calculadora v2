package clase0;

import java.util.Scanner;

/**
 *
 * @author alumno
 */
public class CalculadoraV2 {
    private static double suma(double op1, double op2){
        return op1+op2;
    }
    private static double resta(double op1, double op2){
        return op1-op2;
    }
    private static double multiplicacion(double op1, double op2){
        return op1*op2;
    }
    private static double division(double op1, double op2){
        return op1/op2;
    }
    
    
    public static void main(String[] args) {
        //Bloque de creacion de variables
        double operando1 = 0;
        double operando2 = 0;
        double resultado = 0;
        int operacion = 0;
        Scanner teclado = new Scanner(System.in);
        
        //Bloque de logica del proceso
        System.out.println("Dime el primero operando");
        operando1 = teclado.nextDouble();       
        
        System.out.println("Dime el segundo operando");
        operando2 = teclado.nextDouble();
        
        System.out.println("MENU");
        System.out.println("------------------");
        System.out.println("1 Suma");
        System.out.println("2 Resta");
        System.out.println("3 Multiplicacion");
        System.out.println("4 Division");
        System.out.println("Dime la operacion:");
        operacion = teclado.nextInt();
        
        switch(operacion){
            case 1:
                resultado = suma(operando1,operando2); //operando1 + operando2;
                System.out.println("La suma es:" + resultado);
                break;
            case 2:
                resultado = resta(operando1,operando2); //operando1 - operando2;
                System.out.println("La resta es:" + resultado);
                break;
            case 3:
                resultado = multiplicacion(operando1,operando2); //operando1 * operando2;
                System.out.println("La multiplicación es:" + resultado);
                break;
            case 4:
                resultado = division(operando1,operando2); //operando1 / operando2;
                System.out.println("La division es:" + resultado);
                break;
            default:
                System.out.println("ERROR!!! opciones validas 1,2,3 y 4 ");  
                
                        
        } //fin de switch
        
    } // fin del main
     
} //fin de la clase
